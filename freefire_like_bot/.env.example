# ==========================================================
#  COPIE ESTE ARQUIVO PARA ".env" E PREENCHA
#  (o arquivo .env NÃO vai pro GitHub, é secreto)
# ==========================================================

# --- Bot ---
# Token do bot, pego no @BotFather:
BOT_TOKEN=coloque_seu_token_aqui

# Tema/layout do bot: fire | neon | clean | premium
ACTIVE_THEME=clean

# Nome que aparece no bot:
BOT_NAME=AURORA SYSTEM

# --- API de Like (Frifas) ---
# key da API — é ela que envia os likes. (PEGUE NO PAINEL DA API)
FRIFAS_KEY=coloque_a_key_aqui

# Token OPEN (para o auto-like):
FRIFAS_OPEN=coloque_o_open_aqui

# ACCESS ID (para consultar o auto-like):
FRIFAS_ACCESS_ID=coloque_o_access_id_aqui
