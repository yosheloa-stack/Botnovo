# Copie para .env e preencha com os seus valores.

# Credenciais da conta Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número Twilio que vai originar as ligações (formato E.164, ex: +15551234567)
TWILIO_FROM_NUMBER=

# URL pública onde o webhook server deste bot pode ser alcançado pela Twilio
# (em desenvolvimento, use algo como ngrok: https://xxxx.ngrok-free.app)
PUBLIC_BASE_URL=
PORT=3000

# Número do dono do bot (sem símbolos, com DDI), autorizado a usar !allow
OWNER_NUMBER=
