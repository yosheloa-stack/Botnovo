# Aurora System
AURORA_OWNER_NUMBER=55DDDNUMERO
AURORA_CONNECTION_NUMBER=55DDDNUMERO_DO_BOT
AUTOSYSTEM_URL=https://autolikesystem.com.br
AUTOSYSTEM_TOKEN=SUA_KEY_DA_KASANE
AURORA_RENTAL_TOKEN=UM_SEGREDO_FORTE_IGUAL_NO_SITE
# Aurora com IA (conversa nos grupos e no privado). A API key da conta da
# Square Cloud com a permissão ai:chat — pode ser a mesma do suporte do site.
SQUARECLOUD_API_KEY=SUA_API_KEY_DA_SQUARE_CLOUD
# Quantas respostas da IA por dia no bot (o resto do limite fica pro site).
AURORA_MAX_DIA=300
# Voz da Aurora (Fish Audio): sem a chave, ela só responde em texto.
FISH_AUDIO_API_KEY=SUA_API_KEY_DA_FISH_AUDIO
# ID do modelo de voz escolhido no fish.audio (vazio = voz padrão).
FISH_AUDIO_VOZ=
# Chance de uma resposta curta sair em áudio sem pedirem (0 a 1) e teto por dia.
AURORA_AUDIO_CHANCE=0.2
AURORA_AUDIO_DIA=80
